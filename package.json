{
  "name": "loosenup",
  "version": "2.0.0",
  "private": true,
  "description": "LoosenUp - 2-minute guided calm breaks with a before and after Calm gain. A wellbeing companion, not medical care.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 'tests/unit/*.test.mjs' 'tests/browser/*.test.mjs'",
    "test:unit": "node --test --test-concurrency=1 'tests/unit/*.test.mjs'",
    "test:browser": "node --test --test-concurrency=1 'tests/browser/*.test.mjs'",
    "test:live": "node --test --test-concurrency=1 'tests/live/*.test.mjs'",
    "serve": "node tests/helpers/serve.mjs",
    "cap:sync": "npx cap sync",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-native-biometric": "^8.8.3",
    "@capgo/capacitor-updater": "^8.53.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
