{
  "name": "loosenup",
  "version": "1.3.1",
  "private": true,
  "description": "LoosenUp - 2-minute guided calm breaks with a before and after Calm gain. A wellbeing companion, not medical care.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/",
    "test:unit": "node --test --test-concurrency=1 tests/unit/",
    "test:browser": "node --test --test-concurrency=1 tests/browser/",
    "test:live": "node --test --test-concurrency=1 tests/live/",
    "serve": "node tests/helpers/serve.mjs",
    "cap:sync": "npx cap sync",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
