<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the LoosenUp icon: Breathe now, How are you? and SOS support. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="breathe" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_breathe" android:shortcutLongLabel="@string/shortcut_breathe">
        <intent android:action="android.intent.action.VIEW" android:data="loosenup://go/breathe"
            android:targetPackage="com.loosenup.calm" android:targetClass="com.loosenup.calm.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="checkin" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_checkin" android:shortcutLongLabel="@string/shortcut_checkin_long">
        <intent android:action="android.intent.action.VIEW" android:data="loosenup://go/checkin"
            android:targetPackage="com.loosenup.calm" android:targetClass="com.loosenup.calm.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="sos" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_sos" android:shortcutLongLabel="@string/shortcut_sos_long">
        <intent android:action="android.intent.action.VIEW" android:data="loosenup://go/sos"
            android:targetPackage="com.loosenup.calm" android:targetClass="com.loosenup.calm.MainActivity" />
    </shortcut>
</shortcuts>
