{
  "appId": "com.loosenup.calm",
  "appName": "LoosenUp",
  "webDir": "www",
  "backgroundColor": "#EDF7FF",
  "android": {
    "backgroundColor": "#EDF7FF"
  },
  "ios": {
    "backgroundColor": "#EDF7FF",
    "contentInset": "never"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_loosenup",
      "iconColor": "#F2A72B"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 15000,
      "responseTimeout": 20,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true
    }
  }
}
