<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily check that re-signs the LoosenUp iPhone app when 3 days or less are left.
     Install:  cp scripts/com.loosenup.renew-iphone.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.loosenup.renew-iphone.plist
     Remove:   launchctl bootout gui/$(id -u)/com.loosenup.renew-iphone && rm ~/Library/LaunchAgents/com.loosenup.renew-iphone.plist
     A Mac that is asleep at 10:00 runs it when it wakes. -->
<plist version="1.0">
<dict>
	<key>Label</key><string>com.loosenup.renew-iphone</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/anchittandon/Brightside/scripts/renew-iphone.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key><integer>10</integer>
		<key>Minute</key><integer>0</integer>
	</dict>
	<key>RunAtLoad</key><false/>
	<key>LimitLoadToSessionType</key><string>Aqua</string>
	<key>StandardOutPath</key><string>/Users/anchittandon/Library/Logs/loosenup-renew-iphone.log</string>
	<key>StandardErrorPath</key><string>/Users/anchittandon/Library/Logs/loosenup-renew-iphone.log</string>
</dict>
</plist>
